{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows" }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-osx" }
    },
    {
      "name": "macos-x64",
      "inherits": "base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-osx" }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LUSAKEY_BUILD_APP": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.7.3/msvc2019_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "output": { "outputOnFailure": true } },
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "macos-x64", "configurePreset": "macos-x64", "output": { "outputOnFailure": true } }
  ]
}
